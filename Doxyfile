# Doxyfile for whitehttpd.
#   doxygen Doxyfile
# Output lands in docs/doxygen/html/index.html.
#
# The MIPS assembly reference is parsed too. Its documentation blocks use
# /* */ comments, which Doxygen accepts natively once .s is mapped to C, so
# no input filter is needed.

PROJECT_NAME           = "whitehttpd"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Static file server without libc"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES

JAVADOC_AUTOBRIEF       = YES
QT_AUTOBRIEF            = NO
MULTILINE_CPP_IS_BRIEF  = NO

# Input
INPUT                  = README.md \
                         README_RU.md \
                         BUILDING.md \
                         CONTRIBUTING.md \
                         SECURITY.md \
                         final-4092/whitehttpd.s \
                         final-4092/README.md \
                         whitehttpd_c/src \
                         whitehttpd_c/README.md \
                         whitehttpd_c/README_RU.md
FILE_PATTERNS          = *.c *.h *.s *.md
RECURSIVE              = NO
EXCLUDE                = third_party \
                         build
EXCLUDE_SYMLINKS       = YES
EXTENSION_MAPPING      = s=C
USE_MDFILE_AS_MAINPAGE =

# Extraction
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# Output
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
HTML_OUTPUT            = html
HTML_TIMESTAMP         = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

# Graphs are off: graphviz is not part of the toolchain this project assumes.
HAVE_DOT               = NO

# Warnings
QUIET                  = YES
